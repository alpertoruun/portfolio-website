        metric: "Governed IaC",
        icon: "ph:cube-bold"
      },
      {
        title: "Security & Cost Optimization",
        description: "Implemented OpenCost and Kubeadapt with SSO plus Athena cost pipelines for Spot/On-Demand analysis, creating the visibility needed for node-pool optimization.",
        metric: "Cost visibility",
        icon: "ph:coin-bold"
      }
    ],
    technologies: ["GitHub Actions", "ArgoCD", "Backstage", "AWS CDK", "Terraform", "Atlantis", "Go", "Kubernetes"]
