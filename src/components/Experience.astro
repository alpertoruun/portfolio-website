        metric: "Safer delivery",
        icon: "ph:shield-check-bold"
      },
      {
        title: "Multi-Cluster Segregation",
        description: "Led workload segregation by business domain to strengthen fault isolation and operational independence, using Argo CD's App of Apps pattern for consistent multi-cluster delivery.",
        metric: "Domain isolation",
