  },
  {
    company: "Getir",
    role: "Platform & Infrastructure Engineer I",
    period: "July 2025 - January 2026",
    location: "Izmir, Turkey (Hybrid)",
    type: "recent",
    promotedTo: "Engineer II",
    highlights: [
      {
        title: "Bitbucket to GitHub Migration",
        description: "Automated the migration of 4,000+ repositories from Bitbucket to GitHub with Go and Bash, including repository configuration, CI/CD onboarding, and Argo CD manifest-repository synchronization.",
        metric: "4,000+ repos",
        icon: "ph:arrows-left-right-bold"
      },
      {
        title: "Internal Developer Platform",
        description: "Built Kitchen, Getir’s Backstage-based internal developer platform, with self-service templates for service scaffolding, ECR and Vault provisioning, database connectivity, and Argo CD/CI onboarding.",
